# auto 会选择已配置的服务商，也可固定为 aliyun 或 koukoutu。
MATTING_PROVIDER=auto
MATTING_MAX_UPLOAD_MB=10
MATTING_REQUEST_TIMEOUT_SECONDS=120

# 推荐：由 likeadmin-go 后台统一保存 Provider 与 Key。
MATTING_CONFIG_ENDPOINT=http://127.0.0.1:8003/api/common/ai/matting/internal-config
MATTING_INTERNAL_TOKEN=replace-with-same-token-as-likeadmin-go
MATTING_CONFIG_REQUEST_TIMEOUT_SECONDS=5
MATTING_CONFIG_CACHE_TTL_SECONDS=30

# 抠抠图 API：https://doc.koukoutu.com/
KOUKOUTU_API_URL=https://sync.koukoutu.com/v1/create
KOUKOUTU_API_KEY=

# 阿里云视觉智能开放平台：SegmentCommonImage。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_IMAGESEG_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com
