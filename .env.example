# 变量必须以 VITE_ 为前缀才能由浏览器读取，因此禁止在这里填写 API Key、Secret 或内部令牌。
# NODE_ENV 由 Vite 启动命令管理，不在通用环境文件中覆盖，避免污染生产构建。

# 网站公开信息
VITE_APP_TITLE='UIED-Tools'
VITE_APP_DESC='一个轻量的在线工具箱'
VITE_APP_URL='http://127.0.0.1:5179'

# 同域部署时留空；前后端分域时填写公开 API 地址。
VITE_API_BASE_URL=''

# 本地开发服务
VITE_HOST='127.0.0.1'
VITE_BACKEND_PROXY_TARGET='http://127.0.0.1:8003'
VITE_MATTING_PROXY_TARGET='http://127.0.0.1:8091'
VITE_RESUME_PROXY_TARGET='http://127.0.0.1:3002'
# AI 简历需要独立 Next.js 服务，只有在启动 3002 服务后才开启。
VITE_ENABLE_AI_RESUME='false'
VITE_ENABLE_COEP='false'
