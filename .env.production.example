# 生产环境仅允许填写浏览器可公开读取的配置，禁止放置 API Key、Secret 或内部令牌。
# NODE_ENV 由 npm run build:pro 强制设置，不需要在环境文件中重复声明。
VITE_APP_TITLE='UIED-Tools'
VITE_APP_DESC='免费在线工具集'
VITE_APP_URL='https://uiedtool.com'

# 推荐通过 Nginx 同域转发 /api，此时保持为空。
VITE_API_BASE_URL=''
VITE_ENABLE_COEP='false'

# AI 简历本期暂缓上线，完成静态化与 Go 接口迁移后再开启。
VITE_ENABLE_AI_RESUME='false'
